# live-app 설정 템플릿.
#
# application*.yaml 은 .gitignore 대상이라 저장소에 없다 — 그래서 "어떤 키가 필요한지"를 아는 방법이
# 이 파일뿐이다. 키를 추가·삭제하면 여기도 같이 고칠 것.
#
# 사용법: cp application.yaml.example application.yaml 후 아래 값을 채운다.
#
# ⚠️ 표기 규칙
#   REQUIRED  운영에서 반드시 주입. 기본값을 두면 그 값으로 조용히 뜬다.
#   optional  코드에 기본값이 있어 미설정이 정상. 여기 적힌 건 그 코드 기본값이다.
#
# ⚠️ 이 파일에 실제 자격증명을 넣지 말 것. 전부 자리표시자다.

spring:
  application:
    name: live-app

  datasource:
    url: ${LIVE_DB_URL:jdbc:postgresql://localhost:5432/sapari_db}
    username: ${POSTGRES_USER:postgres}
    password: ${POSTGRES_PASSWORD:}          # REQUIRED (운영)
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      # 스키마는 마이그레이션 Job(infra/migration)이 만든다. 앱은 검증만 — update 로 두면
      # Flyway 가 만든 스키마를 Hibernate 가 임의로 고친다.
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: true
    show-sql: true

  task:
    scheduling:
      pool:
        # 정리 잡 3종이 서로를 막지 않게. 1이면 LiveKit 이 느린 회차에 뒤 잡이 밀린다.
        size: 3

  # 강퇴 명단·밴 미러·강퇴 이벤트 발행이 여기로 간다. streaming-app 과 <b>같은 인스턴스</b>여야
  # 전파가 성립한다 — 다른 Redis 를 가리키면 강퇴가 등록만 되고 아무도 끊기지 않는다.
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}

  # 강퇴 증거 원문을 읽는다(쓰기 없음). streaming-app 과 같은 DB 여야 한다.
  # ⚠️ 접두가 spring.data.mongodb 가 아니라 spring.mongodb 다 — Boot 4.0.0 에서 옛 이름이 제거됐고,
  #    그대로 적으면 값이 바인딩되지 않아 조용히 localhost:27017 로 붙는다.
  #    (redis 쪽 접두 spring.data.redis 는 바뀌지 않았다 — 둘이 달라 보이는 게 정상이다)
  mongodb:
    # 기본값을 비워 둔다. 채워 두면 환경변수가 빠졌을 때 로컬의 빈 Mongo 로 조용히 뜨고,
    # 그러면 강퇴 증거 조회가 항상 empty 라 모든 강퇴가 400 인데 헬스체크는 정상으로 보인다.
    # 비워 두면 ConnectionString 이 IllegalArgumentException 을 던져 부팅에서 죽는다(실측).
    uri: ${MONGODB_URI:}                     # REQUIRED (운영)

server:
  port: ${SERVER_PORT:8081}                  # api-app(8080)과 동시 실행되도록 분리

# /swagger-ui.html 과 /v3/api-docs/** 는 LiveSecurityConfig 에서 permitAll 이다 — 켜져 있으면 인증 없이
# 전체 API 스펙(경로·파라미터·요청/응답 구조)이 나간다. 그래서 기본값을 false 로 둔다: 이 템플릿을 그대로
# 복사해 배포해도 열리지 않아야 한다.
# 로컬·dev·staging 에서는 SPRINGDOC_ENABLED=true 로 켤 것(프론트가 이걸로 API 를 본다).
# 두 키를 함께 걸어야 한다 — api-docs 만 끄면 UI 는 뜨는데 스펙을 못 불러와 빈 화면이 된다.
springdoc:
  swagger-ui:
    enabled: ${SPRINGDOC_ENABLED:false}
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
  api-docs:
    enabled: ${SPRINGDOC_ENABLED:false}
    path: /v3/api-docs
  packages-to-scan: com.sapari

# ---------------------------------------------------------------------------
# 인증 토큰(HMAC) — live-app 은 발급하지 않고 검증만 한다.
# secret 은 api-app 과 같은 값이어야 서명 검증이 통과한다.
# refresh-token-expiration-seconds 는 JwtProperties 의 @NotNull 충족용(여기서는 미사용).
# ---------------------------------------------------------------------------
jwt:
  issuer: ${JWT_ISSUER:sapari-api}
  secret: ${JWT_SECRET:}                     # REQUIRED — 이 키로 임의의 access 토큰을 만들 수 있다
  access-token-expiration-seconds: ${JWT_ACCESS_TOKEN_EXPIRATION_SECONDS:3600}
  refresh-token-expiration-seconds: ${JWT_REFRESH_TOKEN_EXPIRATION_SECONDS:1209600}

live:
  # -------------------------------------------------------------------------
  # 채팅 입장용 룸 토큰(RS256) — live 가 개인키로 서명, chat 이 공개키로 검증.
  # 위 jwt(HMAC)와 키·알고리즘·aud 가 모두 다르며 서로 대체 불가.
  # -------------------------------------------------------------------------
  room-token:
    issuer: ${LIVE_ROOM_TOKEN_ISSUER:live}
    audience: ${LIVE_ROOM_TOKEN_AUDIENCE:chat}
    # 짧게 유지(60~120s). jti 가 없어 창 안에서는 재사용이 가능하므로 창 자체가 방어다.
    expiration-seconds: ${LIVE_ROOM_TOKEN_EXPIRATION_SECONDS:90}
    # REQUIRED — Base64(PKCS#8 DER), PEM 헤더·개행 제외.
    # 기본값을 두지 말 것: resources 에 들어간 값은 jar 에 실려 배포된다(운영에서 env 로 덮어써도 남는다).
    private-key: ${LIVE_ROOM_TOKEN_PRIVATE_KEY:}
    # 서명 캐시 — 같은 claim 으로 또 서명하지 않는다. 걷어내는 비용이 RS256 서명 688µs(실측,
    # RSA-2048 · aarch64 · n=20,000 · p99 735.8µs) = 코어당 1,453건/s 다.
    #
    # 세 키 모두 비워도 된다 — 코드가 기본값을 채운다(enabled=true / slots=16384 / ttl=30s).
    #
    # ⚠️ 걷히는 몫은 절반이다. 게스트 토큰은 sub 가 호출마다 새 임의 UUID 라(게스트 세션을 구분해야
    # 하므로 그래야 한다) 캐시 적중이 구조적으로 0 이고, 게스트가 입장 상한 1,000/s 중 500/s 다.
    # 덮는 절반이 modules/live/AGENTS.md 가 이 경로의 최악 수요로 서술한 회원 재접속 폭풍이다
    # (그 문서의 문구는 "a 1,000-member reconnect storm" — 한국어 명칭은 거기 없다).
    #
    # ⚠️ HMAC 으로 바꾸는 쪽은 기각했다. 실측 HS256 6.4µs = 코어당 156,680건/s 로 108배 싸지만,
    # RS256 을 고른 근거가 비용이 아니라 비대칭이다 — chat 은 공개키로 검증만 하고 발급은 못 해야
    # 한다. 대칭키면 chat 이 룸 토큰을 위조할 수 있고, owner claim 이 chat 의 강퇴·원문 노출 게이트
    # 근거라는 구조가 무너진다.
    cache:
      enabled: ${LIVE_ROOM_TOKEN_CACHE_ENABLED:true}
      # 2의 거듭제곱이어야 한다 — 아니면 기동이 멈춘다(올려 맞추지 않는다: 설정에 적힌 수가 실제
      # 수여야 한다. 형제 member-shards 가 내림 나눗셈으로 500/s 를 448/s 로 만든 실측이 있다).
      # 기본 16384 = 회원 500/s × TTL 30s = 작업집합 15,000 위의 거듭제곱. 상한 65536(토큰 문자열 45MB,
      # 토큰 730자 실측 기준).
      slots: ${LIVE_ROOM_TOKEN_CACHE_SLOTS:16384}
      # expiration-seconds 의 절반 이하여야 한다 — 아니면 기동이 멈춘다. 캐시된 토큰의 exp 는 처음
      # 서명한 시각에 고정돼 있어서, 적중의 잔여 수명 하한이 (발급 - 캐시)다. 기본 90s/30s → 최악 60s.
      ttl-seconds: ${LIVE_ROOM_TOKEN_CACHE_TTL_SECONDS:30}

  # -------------------------------------------------------------------------
  # 고아 라이브 정리 스케줄러 (전부 optional — 코드 기본값 있음)
  #
  # 잡마다 enabled 를 나눈 건 end-stale-live 만 따로 끄기 위해서다 — 셋 중 유일하게 살아 있을지도
  # 모르는 방송을 강제 종료하므로, 오작동이 의심되면 그것만 내린다.
  # cron 은 세 잡이 동시에 LiveKit 을 때리지 않게 3분씩 어긋내 둔다(정렬하지 말 것).
  #
  # ※ 레플리카 2 이상에서 돌 수 있다 — 잡마다 ShedLock 분산 락이 걸려 있어 회차는 한 인스턴스만 돈다
  #    (락 저장소: live_schema.shedlock, 프로바이더 설정은 ReconcileLockConfig).
  #    락을 못 잡은 인스턴스는 조용히 넘어가고 다음 주기에 다시 시도한다.
  #
  #    셋 중 orphan-media 만 DB 전이가 없어 락이 실질적으로 필요하다. 나머지 둘은 행 잠금 + 상태 가드를
  #    지나 커밋한 쪽만 외부 정리를 등록하므로 락이 없어도 파괴적 정리(stop/delete/close)는 한 번뿐이다
  #    — 조회(listAllEgress·listRoomIngress)는 레플리카 수만큼 중복된다. 그래도 세 잡을 같은 방식으로
  #    두는 편이 "이 잡만 왜 다른가"를 매번 확인하지 않아도 되어 안전하다.
  # -------------------------------------------------------------------------
  reconcile:
    # ⚠️ 제거된 키 — 남아 있으면 <부팅이 실패한다>(조용히 무시하면 그 값이 먹는다고 믿게 되므로):
    #      live.reconcile.batch-size            → 잡별 batch-size 로 이전(end-stale-live 10, expire-ready 20)
    #      live.reconcile.orphan-media.batch-size → 대체 없음. 고아 정리는 개수가 아니라 시간으로
    #                                              회차를 묶는다(orphan-media.lock-at-most-for 참고).
    # 마스터 스위치 — off 면 @EnableScheduling·잡 빈·락 설정·부팅 가드가 전부 내려간다.
    # on(기본) 이면 live_schema.shedlock 에 쓸 수 있어야 부팅된다(ShedLockTableGuard — 존재가 아니라
    # 쓰기를 본다: 컬럼 불일치·권한 부족도 여기서 걸린다). 마이그레이션이 앱보다 먼저다.
    enabled: ${LIVE_RECONCILE_ENABLED:true}
    # 회차가 순식간에 끝나도 이만큼은 락을 쥔다. 두 인스턴스의 cron 발화가 지터로 수백 ms 어긋날 때
    # 뒤에 온 쪽이 같은 회차를 한 번 더 도는 걸 막는다.
    # ⚠️ 켜져 있는 잡의 최단 cron 주기의 절반을 넘으면 부팅이 실패한다(ReconcileLockConfig 의
    #    lockIntervalsMustFitInCron). 권고가 아니라 강제다 — 넘기면 다음 회차가 아직 안 풀린 락에
    #    막혀 로그도 지표도 없이 사라진다. 주기는 cron 을 하루치 전개한 최단 간격으로 잰다
    #    (0/N 형태는 시 경계에서 간격이 줄어 첫 간격과 다르다). 값은 PT1M 과 1m 둘 다 받는다.
    # ⚠️ 잡별 lock-at-most-for 는 그 잡의 cron 주기보다 짧으면 부팅이 실패한다(다음 tick 이 늘
    #    만료된 락을 보게 되어 상호배제가 사라진다).
    #    키 형식은 케밥/카멜 어느 쪽이든 같은 값으로 읽힌다 — Spring Boot 가 환경에
    #    ConfigurationPropertySources 를 붙여 두어 @SchedulerLock 의 ${...} 도 relaxed 로 풀린다.
    #    (SchedulerWiringTest 가 세 경로가 같은 값을 보는지 고정한다.)
    lock-at-least-for: ${LIVE_RECONCILE_LOCK_AT_LEAST_FOR:PT1M}
    # OBS 가 끝내 연결되지 않아 Ready 에 갇힌 방 → Ended (송출 중이면 대신 Live 로 승격)
    expire-ready:
      enabled: ${LIVE_RECONCILE_EXPIRE_READY_ENABLED:true}
      threshold: ${LIVE_RECONCILE_READY_THRESHOLD:60m}
      cron: ${LIVE_RECONCILE_EXPIRE_READY_CRON:0 0/10 * * * *}
      # 락 유지 시간 = 락 보유 인스턴스가 죽었을 때의 인계 지연.
      # 이 잡도 end-stale-live 와 같은 이유로 후보당 왕복 수가 고정이 아니다(만료가 타는
      # PostCommitMediaCleanup 은 방의 egress·ingress 를 전부 정리한다). 그래서 리스를 후보 수로
      # 계산하지 않고 회차를 리스 안에 가둔다 — 후보 루프가 이 값의 4/5(기본 40분)를 넘기면 남은
      # 후보를 다음 회차로 넘기고 reconcile.acted{job=expire-ready,action=ROUND_BUDGET_EXHAUSTED}=1 로 남긴다.
      lock-at-most-for: ${LIVE_RECONCILE_EXPIRE_READY_LOCK_AT_MOST_FOR:PT50M}
      # 한 회차의 처리량. 후보마다 LiveKit 을 왕복하므로 다른 잡보다 작게 둔다.
      # 회차 길이의 상한은 이 값이 아니라 위의 회차 예산이다 — 후보당 왕복 수는 방의 화질·ingress
      # 수에 비례해 고정이 아니므로, "후보당 N회" 를 근거로 이 값을 올리면 안 된다.
      batch-size: ${LIVE_RECONCILE_EXPIRE_READY_BATCH_SIZE:20}
    # 방송은 끝났는데 room_finished 유실로 Live 에 갇힌 방 → Ended
    end-stale-live:
      enabled: ${LIVE_RECONCILE_END_STALE_LIVE_ENABLED:true}
      threshold: ${LIVE_RECONCILE_STALE_LIVE_THRESHOLD:60m}
      cron: ${LIVE_RECONCILE_END_STALE_LIVE_CRON:0 3/10 * * * *}
      # 이 잡의 후보당 왕복 수는 고정이 아니다 — 종료 정리가 방의 egress 를 전부 끊는데 그 수는
      # 화질 수라 설정으로 늘어난다. 그래서 리스를 후보 수로 계산하지 않고, 반대로 회차를 리스
      # 안에 가둔다: 후보 루프가 이 값의 4/5 를 넘기면 남은 후보를 다음 회차로 넘긴다(남은 1/5 는
      # 마지막 후보의 정리가 끝날 여유다 — 마감은 후보 사이에서만 보고 진행 중인 호출은 안 끊는다).
      # 잘린 회차는 reconcile.acted{job=end-stale-live,action=ROUND_BUDGET_EXHAUSTED}=1 로 보인다.
      # batch-size 포화(STALE_LIVE_BATCH_SATURATED)와 처방이 다르니 섞어 보지 말 것 —
      # 이 신호가 계속 서면 batch-size 가 아니라 LiveKit 응답 속도를 봐야 한다.
      lock-at-most-for: ${LIVE_RECONCILE_END_STALE_LIVE_LOCK_AT_MOST_FOR:PT25M}
      # 한 회차 처리량. 10 × 10분 주기 = 시간당 60방이다. LiveKit 장애 뒤 room_finished 유실이
      # 대량으로 쌓이면 이 값이 예산보다 먼저 걸리므로, 적체 해소가 급하면
      # LIVE_RECONCILE_END_STALE_LIVE_BATCH_SIZE 를 일시적으로 올릴 것(회차가 길어지는 건 예산이 막는다).
      # STALE_LIVE_BATCH_SATURATED=1 이 계속 서면 그게 이 값이 병목이라는 신호다.
      batch-size: ${LIVE_RECONCILE_END_STALE_LIVE_BATCH_SIZE:10}
    # DB 정본과 어긋난 LiveKit ingress/egress/room 회수.
    # grace 는 생성 직후 정상 리소스를 지우지 않기 위한 유예라 0 이 될 수 없다.
    orphan-media:
      enabled: ${LIVE_RECONCILE_ORPHAN_MEDIA_ENABLED:true}
      grace: ${LIVE_RECONCILE_MEDIA_GRACE:15m}
      cron: ${LIVE_RECONCILE_ORPHAN_MEDIA_CRON:0 6/10 * * * *}
      # 이 잡은 <방>을 순회 단위로 삼는다 — 한 방의 ingress 삭제 → egress 중단 → 방 닫기를 한자리에서
      # 그 순서로 처리한다(하나라도 남기고 방을 닫으면 OBS 가 방을 되살린다). 그래서 개수 상한이 없고,
      # 정지 규칙은 이 값의 4/5(기본 16분)를 마감으로 삼는 것 하나뿐이다.
      # 넘기면 reconcile.acted{job=orphan-media,action=ROUND_BUDGET_EXHAUSTED}=1 로 남고, 남은 방은
      # 다음 회차가 가져간다(그 방은 닫지 않은 채로 넘긴다).
      # ⚠️ live.reconcile.orphan-media.batch-size 는 제거됐다 — 남아 있으면 부팅이 실패한다.
      #    처리량은 이 값으로 조절한다. 락 연장은 죽은 인스턴스 판정을 늦추므로 사용하지 않는다.
      lock-at-most-for: ${LIVE_RECONCILE_ORPHAN_MEDIA_LOCK_AT_MOST_FOR:PT20M}

  # -------------------------------------------------------------------------
  # webhook 수신 경로 레이트리밋 (전부 optional — 코드 기본값 있음)
  #
  # 이건 트래픽 셰이퍼가 아니라 최악의 CPU 소모에 거는 상한이다. 정상 트래픽 부근으로 내리지 말 것 —
  # /webhooks/livekit 은 permitAll 이라 한도가 곧 미인증 공격자의 비용이고, 낮추면 공격자가 그 rps
  # 만으로 정상 ingress_started 를 429 로 굶길 수 있다. rps 제한은 앞단(Ingress/WAF)의 몫이다.
  # 앞단에 이미 걸려 있으면 enabled: false 로 내려도 된다.
  # -------------------------------------------------------------------------
  webhook:
    rate-limit:
      enabled: ${LIVE_WEBHOOK_RATE_LIMIT_ENABLED:true}
      permits-per-second: ${LIVE_WEBHOOK_RATE_LIMIT_PERMITS:500}
      burst: ${LIVE_WEBHOOK_RATE_LIMIT_BURST:1000}   # permits-per-second 이상이어야 부팅된다

  # -------------------------------------------------------------------------
  # 입장(룸 토큰 발급) 상한 — 게스트·회원이 각자 버킷 (전부 optional, 코드 기본값 있음)
  #
  # GET /api/v1/lives/rooms/{roomId} 는 미인증도 받고 호출마다 새 룸 토큰을 찍는다. 그 한 건이
  # 치르는 것은 둘 — findById(방송을 시작하는 그 커넥션 풀) 와 RS256 <서명>이다.
  # 실측(RSA-2048): 서명 685µs = 코어당 1,458건/s. 위 webhook 과 비교하지 말 것 — 그쪽은 RSA
  # 검증을 아예 하지 않는다(LiveKit API secret 이 대칭키라 본문 해싱 + 대칭 JWT 검증이고, 그
  # javadoc 의 실측값이 본문 크기에 비례하는 것이 그 지문이다).
  #
  # 버킷이 둘인 이유: 하나면 둘 중 하나가 거짓이 된다. 전역 하나면 공격자가 한도를 선점해 로그인
  # 회원의 입장까지 막고, 게스트에만 걸면 인증 쪽 CPU 가 열린 채 남는다 — 가입이 셀프서비스고
  # 이 경로의 JWT 필터는 폐기 저장소를 안 봐서 토큰 하나로 TTL 동안 무제한 호출이 된다.
  #
  # ⚠️ "두 버킷 합 1,000/s 는 천장의 69%" 는 <코어가 1개일 때만> 참이다. 위 1,458건/s 는 코어당이고
  # 처리량은 코어에 거의 선형이다(실측, 같은 실행: 1스레드 1,436 / 2 → 2,777 / 4 → 5,450건/s).
  # 같은 1,000/s 가 1코어면 69.6% · 2코어면 36.0% · 4코어면 18.3% 이고(세 셀 전부 위 한 표에서 읽는다 — 지연
  # 실측 쪽은 1,453건/s 라 1코어가 68.8% 인데, 한 수열에 두 측정을 섞지 않는다), 이 저장소에는 배포 코어 수가
  # 적힌 곳이 없다. 코어당 수를 함대 수요에 바로 대지 말 것.
  #
  # 그 분모를 모르는 채 한도를 올리는 대신 서명 쪽을 줄였다 — live.room-token.cache 참조(위, room-token 블록 안).
  # 걷히는 몫은 절반이다: 게스트 토큰은 sub 가 호출마다 새 임의 UUID 라 캐시가 불가능하고 그쪽이
  # 500/s 다. HMAC 분리는 기각 — 108배 싸지만 chat 이 룸 토큰을 위조할 수 있게 된다.
  #
  # ⚠️ 정상 트래픽은 측정되지 않았다. 구체적 수요 벡터 하나는 선다 — 재접속 폭풍: 룸 토큰 TTL
  # 이 ~90s 이고 단일 사용이 아니라서 streaming-app 롤링 재시작이면 전 게스트가 새 입장을
  # 받아야 하고 그 전부가 이 버킷을 지난다. 거부가 시작되면 그것이 첫 측정값이다.
  #
  # ⚠️ 실효 한도는 (한도 × 레플리카) 다 — 버킷은 인스턴스 로컬이고 함대 기준 상한은 없다.
  #
  # 회원 쪽은 샤드가 하나 더 있다. member-shards 개의 고정 크기 버킷 배열을 (솔트 + sub) 해시로
  # 골라 한 계정이 먹는 양을 자기 샤드로 묶는다. 샤드 몫은 전역을 올림으로 나눈 값(버스트는
  # 거기에 헤드룸 2배)이라 샤드 합이 전역을 넘고, 그래서 아래 적은 수가 실제 천장이다 —
  # 바닥으로 나누면 기본값에서 지속 448/s · 버스트 960 만 집행됐다.
  # ⚠️ 솔트는 프로세스 로컬이다. 없으면 공격자가 대상 샤드를 오프라인에서 계산한다(미인증 목록
  # 응답이 판매자 userId 를 주고 String.hashCode 는 JDK 규격이다) — 계정 하나로 특정 판매자를
  # 상시 끊을 수 있었다. 그래서 레플리카마다 같은 판매자가 다른 샤드에 떨어진다.
  # ⚠️ 공정성 해결이 아니다: 같은 샤드에 해싱된 회원(64샤드에서 약 1.6%)은 같이 거부된다. 샤드
  # 전수를 덮는 비용은 선형이 아니라 쿠폰 수집이다 — 64샤드에 평균 301개 계정(측정). 방 주인
  # 예약 용량은 여전히 없고, 호출자 단위 rps 공정성은 상류(Ingress·WAF) 몫이다.
  #
  # ⚠️ 분모가 CPU 하나만은 아니다 — findById 가 커넥션을 쓰고 Hikari 기본 최대 풀은 10 인데
  # 이 저장소에 maximum-pool-size 가 없다. 다만 <서명>은 더 이상 커넥션을 쥐지 않는다:
  # EnterLiveService.enter 에 @Transactional 이 없어 읽기가 자기 트랜잭션으로 끝나고 반납된
  # 뒤에 서명이 돈다(그 부재를 EnterLiveServiceTest 가 단정한다).
  #
  # 거부는 live.enter.rejected{population,gate} 로 나간다. gate=shard 는 "그 계정을 찾아라",
  # gate=global 은 "한도를 올려라" 다 — 대응이 반대라 합쳐서 알림을 만들면 안 된다. 샤드 합이
  # 전역을 넘으므로 분산 과부하에서는 대다수가 global 이다. 태그 값은 전부 소문자다.
  #
  # ⚠️ 이 429 는 본문이 없어 error.code 가 없다 — 같은 엔드포인트의 다른 에러는 봉투로 나간다.
  # 교차 출처 SPA 는 Retry-After 도 못 읽을 수 있다(이 저장소에 CORS 노출 헤더 설정이 0건이라
  # 게이트웨이가 보태지 않으면 브라우저에 그 헤더가 없다).
  #
  # ⚠️ 이 상한은 <발급> 측이다. WS 세션 수를 묶지 않는다 — 룸 토큰은 TTL 안에서 재사용 가능하고
  # streaming-app 의 MAX_SESSIONS_PER_USER_PER_ROOM=5 는 게스트의 임의 userId 때문에 토큰당 5로
  # 동작한다. 즉 500/s × 5 = 파드당 2,500 신규 세션/s 가 이 상한을 전혀 위반하지 않고 가능하다.
  # 세션 쪽 예산은 별 축이고, 한도를 고를 때 같이 봐야 한다.
  #
  # enabled 스위치는 없다 — "제한 없음" 은 한도를 올려서 표현한다(설정이 둘이 되지 않게).
  # ⚠️ 복구 = 롤링 재시작. 버킷은 생성자에서 1회 조립되고 @RefreshScope 가 아니다. 입장이 전면
  # 거부되는 사고에서 그것이 유일한 수단이며, 재시작 중에도 거부는 계속되고 새 인스턴스는
  # 버킷이 가득 찬 상태로 시작한다(증상이 10초 단위로 오해될 수 있다).
  # -------------------------------------------------------------------------
  enter:
    rate-limit:
      guest-permits-per-second: ${LIVE_ENTER_GUEST_PERMITS:500}
      guest-burst: ${LIVE_ENTER_GUEST_BURST:1000}       # permits 이상이어야 부팅된다
      member-permits-per-second: ${LIVE_ENTER_MEMBER_PERMITS:500}
      member-burst: ${LIVE_ENTER_MEMBER_BURST:1000}     # permits 이상이어야 부팅된다
      member-shards: ${LIVE_ENTER_MEMBER_SHARDS:64}     # 1~4096 이고 member-permits 이하여야 부팅된다
                                                        # (상한이 없으면 오타가 거대한 배열을 만든다)

# ---------------------------------------------------------------------------
# LiveKit
#
# host / hls.cdn-base-url 은 루프백이 아니면 https 여야 부팅된다(소문자 스킴). 평문이면 매 호출마다
# S3 자격증명과 API JWT 가 그대로 노출되고, cdn-base-url 은 시청자에게 나가는 재생 URL 이다.
# api-key / api-secret 은 기본값을 두지 말 것 — host 와 달리 코드가 막아주지 않아 조용히 뜬다.
# ---------------------------------------------------------------------------
livekit:
  host: ${LIVEKIT_HOST:http://127.0.0.1:7880}
  api-key: ${LIVEKIT_API_KEY:}               # REQUIRED
  api-secret: ${LIVEKIT_API_SECRET:}         # REQUIRED — 임의 방 publish 토큰 발급 + webhook 서명 위조가 가능
  s3:
    bucket: ${S3_BUCKET:}                    # REQUIRED
    region: ${S3_REGION:ap-northeast-2}
    key-prefix: ${S3_KEY_PREFIX:live/}
    access-key: ${S3_ACCESS_KEY:}            # REQUIRED
    secret-key: ${S3_SECRET_KEY:}            # REQUIRED
  hls:
    cdn-base-url: ${HLS_CDN_URL:http://localhost:8081/live}
    segment-duration: 2                      # 세그먼트 길이(초)

# ---------------------------------------------------------------------------
# 관측(actuator / micrometer)
#
# ⚠️ 관리 포트를 분리한다. 지표에는 방송 수·판매자 활동량 같은 영업 지표가 담기고, 게이지는
# 스크레이프마다 DB 를 조회한다 — 사용자 트래픽 포트에 열면 무인증 고빈도 스크레이프가
# 방송 시작과 같은 커넥션 풀을 먹는다. 같은 포트 + permitAll 은 "인그레스가 /actuator 를
# 막아준다" 를 전제로만 성립하는데 이 저장소에 그 제한은 없다.
#
# 이 포트는 클러스터 내부에만 노출할 것(Service/Ingress 에서 외부로 뚫지 말 것).
# k8s 매니페스트에 포트와 스크레이프 대상 설정이 없으면 지표만 수집되지 않는다 —
# 앱 부팅과 방송 기능에는 영향이 없다.
#
# 노출 항목을 명시하는 이유: 기본값에 기대면 액추에이터 버전이 올라갈 때 새 엔드포인트가
# 조용히 열린다. 포트가 내부 전용이어도 configprops·env 까지 열 이유는 없다.
# ---------------------------------------------------------------------------
management:
  server:
    port: ${MANAGEMENT_PORT:8091}      # REQUIRED(운영) — server.port(위 47행, 기본 8081)와 달라야 한다.
                                       # 같으면 LiveSecurityConfig.managementPortMustDiffer 가 부팅을 막는다.
  endpoints:
    web:
      exposure:
        # 액추에이터 기본 노출은 health 하나뿐이다 — 이건 좁힌 값이 아니라 prometheus 를 더한 값이다.
        # 넓히지 말 것: LiveSecurityConfig 가 이 두 개만 permitAll 하고 나머지는 denyAll 이라,
        # 여기에 추가해도 열리지 않고 403 만 난다(코드도 함께 고쳐야 한다 = 리뷰에 보인다).
        include: health,prometheus     # REQUIRED(운영) — 둘 중 하나라도 실제로 노출되지 않으면
                                       # 부팅이 실패한다(LiveSecurityConfig.requiredEndpointsMustBeExposed).
                                       # 가드는 이 키를 읽지 않고 <b>실제 노출</b>을 묻는다 — 그래서
                                       # exclude 로 되돌리거나 management.endpoint.<id>.enabled=false,
                                       # endpoints.enabled-by-default=false, endpoint.<id>.access=none,
                                       # endpoints.access.default=none 로 끄는 것도 전부 걸린다.
                                       # health 가 빠지면 k8s 프로브가 401 을 받아 파드가 Ready 가
                                       # 되지 못한다. 액추에이터 기본
                                       # 노출은 health 하나라, 빠뜨리면 지표 엔드포인트가 생기지 않고
                                       # 스크레이퍼가 401 을 받아 <b>지표가 조용히 빈다</b> — 빈 대시보드는
                                       # "방송이 없어서" 와 구분되지 않는다. 종전 optional 표기는 그
                                       # 결과를 과소평가한 것이었다(실측: CI 로 옮긴 첫 실행이 401 로 깨짐).
  endpoint:
    health:
      show-details: never              # optional — 상세는 DB 주소 등 내부 구조를 흘린다
  metrics:
    tags:
      application: live-app            # optional — 여러 앱을 한 프로메테우스로 모을 때 구분자
