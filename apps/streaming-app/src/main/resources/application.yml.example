# streaming-app 설정 템플릿.
#
# application*.yml 은 .gitignore 대상이라 저장소에 없다 — 그래서 "어떤 키가 필요한지"를 아는 방법이
# 이 파일뿐이다. 키를 추가·삭제하면 여기도 같이 고칠 것.
#
# 사용법: cp application.yml.example application.yml 후 아래 값을 채운다.
#
# ⚠️ 표기 규칙
#   REQUIRED  운영에서 반드시 주입. 기본값을 두면 그 값으로 조용히 뜬다 — 그래서 두지 않는다.
#             미설정이면 부팅이 실패하는데 가드가 값마다 다르다: 공개키는 RoomTokenConfig 가 직접
#             거부하고, Mongo URI 는 드라이버가 거부한다. 후자는 진단 문구에 MONGODB_URI 라는
#             이름이 나오지 않으니 아래 mongodb 주석을 함께 읽을 것.
#   optional  코드에 기본값이 있어 미설정이 정상. 여기 적힌 건 그 코드 기본값이다.
#
# ⚠️ ${VAR:} 의 빈 기본값을 둘지는 REQUIRED/optional 이 아니라 <b>대상 타입</b>이 정한다 (실측).
#   env 가 없을 때 ${VAR:} 는 "미설정"이 아니라 <b>빈 문자열로 설정됨</b>이고, 그러면 코드의
#   @Value("${키:기본값}") 에 있는 기본값이 쓰이지 않는다.
#     String 타깃   빈 문자열이 그대로 바인딩된다 — 변환이 없으니 부팅이 그 자체로는 막히지 않는다.
#                   그 다음은 <b>키마다 다르다</b>: public-key 는 코드가 isBlank() 로 거부해 친절한
#                   부팅 실패가 되고(그래서 ${CHAT_ROOMTOKEN_PUBLICKEY:} 가 맞다 — 빈 기본값을 떼면
#                   PlaceholderResolutionException 이 먼저 나 그 친절함이 사라진다),
#                   chat.profanity.* 는 빈 값이 합법이라 마스킹이 pass-through 로 조용히 꺼지고,
#                   spring.data.redis.host 는 스프링 기본값 localhost 로 간다. "String 이면 안전" 이
#                   아니라 "String 이면 변환이 안 막으니 그 키의 코드를 봐야 한다" 가 규칙이다.
#     Integer 타깃  Duration 과 같다 — 빈 문자열이 숫자로 변환되지 않는다. 아래 REDIS_PORT 가 그
#                   경우이고, 그래서 ${REDIS_PORT:6379} 처럼 기본값이 플레이스홀더 안에 있다.
#                   String 규칙을 적용해 ${REDIS_PORT:} 로 바꾸지 말 것.
#     Duration 타깃 빈 문자열이 null 로 변환돼 가드가 "필수" 로 죽는다. 코드 기본값을 쓰려면 그 줄을
#                   <b>주석 처리</b>해 키가 아예 없는 상태로 둘 것 — 아래 chat.session 이 그 모양이다.
#                   (측정: 빈 문자열 → null / 키 부재 → 60m / 값 있음 → 그 값)
#
# ⚠️ 배포 전제 — 머지 전에 읽을 것
#   CHAT_ROOMTOKEN_PUBLICKEY 가 <b>롤아웃 전에</b> 환경에 있어야 한다. 매니페스트가 먼저 가고 앱이
#   따른다 — 없이 올리면 컨텍스트가 뜨지 않아 CrashLoopBackOff 다(실측된 부팅 실패).
#   live-app 의 MANAGEMENT_PORT 가 같은 성격이고 그쪽 전제는 infra/AGENTS.md 에 적혀 있다.
#
# ⚠️ 이 파일에 실제 자격증명을 넣지 말 것. 전부 자리표시자다.
#
# ⚠️ 이 앱은 관계형 DB를 쓰지 않는다(DB-free). chat-core가 강퇴 로그 때문에 JPA를 의존해 스타터가
#    전이로 올라오지만, StreamingAppApplication이 DataSource 자동설정을 잘라낸다. datasource 키를
#    여기 추가하지 말 것 — 넣는 순간 이 앱이 관계형 DB에 묶인다.

spring:
  data:
    redis:
      host: ${REDIS_HOST:localhost}          # optional (로컬 기본값)
      port: ${REDIS_PORT:6379}               # optional

  # ⚠️ 접두가 spring.data.mongodb 가 아니라 spring.mongodb 다.
  #    Boot 4.0.0에서 spring.data.mongodb.* 가 제거됐고(replacement: spring.mongodb.*),
  #    옛 이름으로 적으면 값이 바인딩되지 않아 MONGODB_URI를 넣어도 조용히 무시되고
  #    기본값 localhost:27017 로 붙는다. 그 상태로 뜨면 인덱스 생성 러너가 타임아웃으로 죽는다.
  #    (redis 쪽 접두 spring.data.redis 는 바뀌지 않았다 — 둘이 달라 보이는 게 정상이다)
  #
  # ⚠️ 기본값을 두지 않는다. 위 범례가 적은 대로 REQUIRED 에 기본값을 두면 그 값으로 조용히 뜨는데,
  #    여기서는 그 조용함이 두 갈래다 — 운영 호스트에 localhost Mongo 가 없으면 인덱스 생성 러너가
  #    죽어 부팅이 실패하고(시끄럽다), 무언가 떠 있으면 <b>입장도 되고 실시간 전달도 되는데 메시지만
  #    엉뚱한 DB 에 쌓인다</b>. 이 설계가 "실시간 전달 best-effort, 영속만 보장"이라고 못 박은 바로
  #    그 보장 쪽이라, 두 번째 갈래가 특히 나쁘다.
  mongodb:
    uri: ${MONGODB_URI}                                    # REQUIRED (운영) — 기본값 없음

# 룸 토큰 검증용 live 공개키. live가 개인키로 서명하고 이 앱은 공개키로 검증만 한다.
# 값은 live에서 받아 env로 주입한다(Base64 SPKI, PEM 헤더 없이 본문만).
chat:
  room-token:
    public-key: ${CHAT_ROOMTOKEN_PUBLICKEY:}               # REQUIRED (운영)

  # 욕설 사전. 비워 두면 마스킹이 전혀 일어나지 않는다(pass-through).
  # 정본은 live_schema.chat_filter_word 테이블이지만 이 앱은 DB-free라 로더가 아직 없다.
  profanity:
    words: ${CHAT_PROFANITY_WORDS:}                        # optional (CSV)
    whitelist: ${CHAT_PROFANITY_WHITELIST:}                # optional (CSV)

  # 연결 하나에 걸리는 시간 상한 셋 — 셋 다 optional 이라 평소에는 건드릴 필요가 없다.
  #
  # ⚠️ 아래가 주석인 것이 의도다. 위 표기 규칙의 Duration 항목이 그 이유다 — ${VAR:} 로 적고 env 를
  #    안 넣으면 빈 문자열이 코드 기본값을 밀어내 <b>부팅이 실패한다</b>. 이 파일은 그대로 복사하라고
  #    지시하므로, 그 모양으로 두면 복사한 사람에게 CrashLoopBackOff 가 된다.
  #
  # ⚠️ env 로 주입하려고 플레이스홀더를 쓸 필요가 <b>없다.</b> 키가 yml 에 아예 없어도 env 는
  #    완화 이름 해석으로 바인딩된다 (실측: 키 부재 + CHAT_SESSION_MAX_LIFETIME=17m → PT17M,
  #    env 없음 → PT1H). 그 해석이 바인더가 아니라 프로퍼티 소스에 있어서 @Value 에도 적용된다.
  #    굳이 플레이스홀더로 적겠다면 기본값을 <b>반드시</b> 안에 둘 것 — ${CHAT_SESSION_MAX_LIFETIME:60m}.
  #    한 글자가 빠져 ${CHAT_SESSION_MAX_LIFETIME:} 가 되면 위 함정으로 돌아간다.
  #
  #    값을 바꾸려면 주석을 풀고 값을 적는 쪽이 가장 안전하다.
  #
  # 서로 제약한다(아니면 부팅 실패: SessionTimeouts). 셋 다 양수여야 하고,
  #   ① 기한 >= 간격 × 2
  #   ② 지터를 뺀 최소 수명 > 기한 + 간격
  #
  # ②가 두 군데서 직관과 어긋나므로 풀어 적는다.
  #   - 수명은 아래로 15% 흩어진다(재접속이 한 점에 몰리지 않게). 그래서 비교 대상은 적은 값이
  #     아니라 그 값의 85% 다
  #   - 첫 생존 점검은 기한이 아니라 기한 + 간격이다(생존 시계가 등록 시각으로 초기화되므로,
  #     기한에 바로 점검하면 첫 창에서만 유실 내성이 한 칸 짧아진다)
  # 기본값(기한 90s·간격 30s)에서는 <b>max-lifetime > 141s</b> 가 된다 — 90s 보다 크면 된다고
  # 읽고 2m 를 넣으면 거부된다(120 × 0.85 = 102 <= 120).
  #
  # ⚠️ <b>수명을 짧게 하려면 기한·간격을 같이 내려야 한다.</b> 아래 설명대로 이 값은 "권위 반영
  #    상한" 이라, 그걸 조이려고 수명만 내리는 것이 가장 자연스러운 동작인데 그 길이 막혀 있다.
  #    예: 2분으로 하려면 (max-lifetime 2m, ping-interval 20s, liveness-deadline 60s) — 첫 점검이
  #    80s 가 되어 102s > 80s 로 통과한다. 수명만 2m 로 내리면 부팅이 실패한다.
  #
  #    ⚠️ <b>간격을 20s 로 함께 내리는 것이 핵심이다.</b> 두 가드만 보면 (2m, 30s, 60s) 도 통과하는데,
  #    그 트리오는 기한/간격 비가 2배여서 연속 PONG 유실 내성이 <b>2회에서 1회로</b> 깎인다
  #    (판정이 now - last >= 기한 이라 k회 연속 유실이 k × 간격을 만들고, 그것이 기한보다 작아야
  #    산다 → 비율 3배면 2회, 2배면 1회). 네트워크가 조금 흔들리는 클라이언트가 그만큼 더 끊긴다.
  #    기본값이 3배(90/30)인 이유가 그것이고, 보안을 조이면서 그 내성까지 지키려면 비율을 3배로
  #    유지해야 한다.
  #
  #    일반식: 기한을 간격의 3배로 유지하려면 <b>간격 < 0.2125 × 수명</b>(= 0.85 × 수명 / 4).
  #    수명 2분이면 간격 < 25.5s 다. 대가는 ping 주기가 30s → 20s 로 촘촘해지는 것뿐이다.
  #
  # 수명 상한이 있는 이유: 입장 토큰은 핸드셰이크 때 한 번만 검증되므로 그 뒤의 역할 강등·방
  # 소유권 이전은 이 세션에 닿지 않는다. 재접속이 live 의 입장을 다시 타므로, 이 값이
  # "접속 후 바뀐 권위가 반영되기까지의 상한"이 된다.
  #
  # session:
  #   max-lifetime: 60m          # 코드 기본값 (env: CHAT_SESSION_MAX_LIFETIME)
  #   ping-interval: 30s         # 코드 기본값 (env: CHAT_SESSION_PING_INTERVAL)
  #   liveness-deadline: 90s     # 코드 기본값, 3 × ping (env: CHAT_SESSION_LIVENESS_DEADLINE)
