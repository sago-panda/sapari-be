### 판매자 로그인 → sellerToken 전역 캡처
# api-app(apiAuthBaseUrl)에서 발급. 응답 Authorization 헤더의 Bearer 토큰을 전역변수로 저장한다.
# 이후 모든 판매자 요청이 {{sellerToken}}을 사용한다.
POST {{apiAuthBaseUrl}}/api/v1/sellers/auth/login
Content-Type: application/json

{
  "email": "{{sellerEmail}}",
  "password": "{{sellerPassword}}"
}

> {%
    client.test("로그인 200", function () {
        client.assert(response.status === 200, "로그인 실패: status=" + response.status);
    });
    const auth = response.headers.valueOf("Authorization");
    client.test("Authorization 헤더 존재", function () {
        client.assert(auth != null && auth.length > 0, "Authorization 헤더 없음");
    });
    const token = auth.replace(/^Bearer\s+/i, "");
    client.global.set("sellerToken", token);
    client.log("sellerToken 캡처 완료(길이 " + token.length + ")");
%}

###
# customerToken(비-SELLER 토큰)은 OAuth 소셜 로그인이라 스크립트 자동화가 어렵다.
# 403 테스트(04 파일)용으로, 발급받은 비-판매자 access token을 http-client.private.env.json의 customerToken에 직접 넣는다.
