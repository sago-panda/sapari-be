# 구매자 공개 상세 조회. 인증 불필요. ON_SALE 상품만 노출(M-4 게이트), 그 외/없음은 404.

### [1/3] 공개 상세 (GET) → 200. ON_SALE 상품 상세 + 필드 검증
GET {{productBaseUrl}}/api/v1/products/{{onSaleProductId}}

> {%
    client.test("200 OK", function () {
        client.assert(response.status === 200, "ON_SALE 상품이 아님/없음: " + response.status);
    });
    const d = response.body;
    client.test("핵심 필드 존재", function () {
        client.assert(d.productId != null, "productId 없음");
        client.assert(d.sellerId != null, "sellerId 없음");
        client.assert(d.status === "ON_SALE", "status=" + d.status);
        client.assert(d.version != null, "version 없음(낙관적 락 왕복용)");
    });
    client.test("옵션 트리·조합 존재", function () {
        client.assert(Array.isArray(d.optionTypes), "optionTypes 배열 아님");
        client.assert(Array.isArray(d.combinations), "combinations 배열 아님");
    });
    client.test("조합 항목에 version 노출", function () {
        if (d.combinations.length > 0) {
            client.assert(d.combinations[0].version != null, "combination.version 없음");
            client.assert(d.combinations[0].combinationId != null, "combinationId 없음");
        }
    });
%}

### [2/3] 존재하지 않는 상품 → 404 PRODUCT-001 (에러 봉투)
GET {{productBaseUrl}}/api/v1/products/11111111-1111-1111-1111-111111111111

> {%
    client.test("404 Not Found", function () {
        client.assert(response.status === 404, "expected 404, got " + response.status);
    });
    client.test("에러 봉투 PRODUCT-001", function () {
        client.assert(response.body.success === false, "success!=false");
        client.assert(response.body.error.code === "PRODUCT-001", "code=" + response.body.error.code);
        client.assert(response.body.error.status === 404, "error.status=" + response.body.error.status);
    });
%}

### [3/3] 비공개 상태(PENDING_REVIEW 등)는 공개 상세로 노출되지 않음 → 404
# 01에서 만든 신규 상품(PENDING_REVIEW)을 삭제 전에 조회하면 404여야 한다(게이트).
# 01을 끝까지 실행해 삭제했다면 freshProductId도 404. 게이트 동작 확인용.
GET {{productBaseUrl}}/api/v1/products/{{freshProductId}}

> {%
    client.test("비공개/삭제 상품은 404", function () {
        client.assert(response.status === 404, "expected 404(비공개 게이트), got " + response.status);
    });
    client.test("PRODUCT-001", function () {
        client.assert(response.body.error.code === "PRODUCT-001", "code=" + response.body.error.code);
    });
%}
