# api-app 설정 템플릿.
#
# application*.yml 은 .gitignore 대상이라 저장소에 없다 — 그래서 "어떤 키가 필요한지"를 아는 방법이
# 이 파일뿐이다. 키를 추가·삭제하면 여기도 같이 고칠 것.
#
# 사용법: cp application.yml.example application.yml 후 아래 값을 채운다.
#
# ⚠️ 표기 규칙
#   REQUIRED  비어 있으면 기동이 거부된다(설정 클래스가 검증한다).
#   optional  코드에 기본값이 있어 미설정이 정상. 여기 적힌 건 그 코드 기본값이다.
#
# ⚠️ 이 파일에 실제 자격증명을 넣지 말 것. 전부 자리표시자다.

spring:
  application:
    name: api-app

  datasource:
    url: ${API_DB_URL:jdbc:postgresql://localhost:5432/sapari_db}
    username: ${POSTGRES_USER:postgres}
    password: ${POSTGRES_PASSWORD:}          # REQUIRED (운영)
    driver-class-name: org.postgresql.Driver

  jpa:
    hibernate:
      # 스키마는 마이그레이션 Job(infra/migration)이 만든다. 앱은 검증만 한다.
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.PostgreSQLDialect
        format_sql: true
    show-sql: true

  # 리프레시 토큰·가입 인증 코드·소셜 가입 시도 제한이 여기에 저장된다.
  data:
    redis:
      host: ${REDIS_HOST:localhost}
      port: ${REDIS_PORT:6379}

  security:
    oauth2:
      client:
        registration:
          naver:
            client-id: ${NAVER_CLIENT_ID:}               # REQUIRED
            client-secret: ${NAVER_CLIENT_SECRET:}       # REQUIRED
            redirect-uri: ${NAVER_REDIRECT_URI:http://localhost:8080/api/v1/customers/auth/oauth2/code/naver}
            authorization-grant-type: authorization_code
            scope: [name, nickname, email, profile_image, gender, birthday, birthyear, mobile]
            client-name: Naver
          kakao:
            client-id: ${KAKAO_CLIENT_ID:}               # REQUIRED
            client-secret: ${KAKAO_CLIENT_SECRET:}       # REQUIRED
            client-authentication-method: client_secret_post
            redirect-uri: ${KAKAO_REDIRECT_URI:http://localhost:8080/api/v1/customers/auth/oauth2/code/kakao}
            authorization-grant-type: authorization_code
            scope: [name, profile_nickname, account_email, profile_image, gender, birthday, birthyear, phone_number]
            client-name: Kakao
        provider:
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

server:
  port: ${SERVER_PORT:8080}

# 켜져 있으면 인증 없이 전체 API 스펙이 나간다. 기본은 끄고, 로컬·dev 에서 SPRINGDOC_ENABLED=true 로 켠다.
# 두 키를 함께 걸어야 한다 — api-docs 만 끄면 UI 는 뜨는데 스펙을 못 불러와 빈 화면이 된다.
springdoc:
  swagger-ui:
    enabled: ${SPRINGDOC_ENABLED:false}
    path: /swagger-ui.html
    tags-sorter: alpha
    operations-sorter: alpha
  api-docs:
    enabled: ${SPRINGDOC_ENABLED:false}
    path: /v3/api-docs
  packages-to-scan: com.sapari

# 인증 토큰(HMAC) — api-app 이 발급한다. secret 은 검증하는 앱(live-app 등)과 같은 값이어야 한다.
jwt:
  issuer: ${JWT_ISSUER:sapari-api}
  secret: ${JWT_SECRET:}                         # REQUIRED, 32자 이상
  access-token-expiration-seconds: ${JWT_ACCESS_TOKEN_EXPIRATION_SECONDS:1800}
  refresh-token-expiration-seconds: ${JWT_REFRESH_TOKEN_EXPIRATION_SECONDS:1209600}
  refresh-token-reuse-grace: ${JWT_REFRESH_TOKEN_REUSE_GRACE:5s}   # optional, 0~30s (0 = 유예 끔)

customer:
  oauth2:
    # 소셜 로그인 성공·추가 가입 필요 시 프론트로 보내는 주소.
    redirect:
      login-success-url: ${CUSTOMER_OAUTH2_LOGIN_SUCCESS_URL:http://localhost:3000/login/success}
      signup-url: ${CUSTOMER_OAUTH2_SIGNUP_URL:http://localhost:3000/signup/social}
      failure-url: ${CUSTOMER_OAUTH2_FAILURE_URL:http://localhost:3000/login/failure}   # REQUIRED, http(s) 절대 URL
    # 소셜 로그인 인가 요청 쿠키 암호화 키. 모든 Pod 같은 값. 생성: openssl rand -base64 32
    authorization-request-cookie:
      encryption-key: ${CUSTOMER_OAUTH2_AUTH_REQUEST_COOKIE_KEY:}   # REQUIRED, Base64 32바이트

seller:
  business-registration:
    nts:
      base-url: ${NTS_BUSINESS_BASE_URL:https://api.odcloud.kr/api/nts-businessman/v1}   # optional
      service-key: ${NTS_BUSINESS_SERVICE_KEY:}  # 비어 있으면 기동은 되고 사업자 확인 요청만 실패한다
      connect-timeout: ${NTS_BUSINESS_CONNECT_TIMEOUT:3s}                                  # optional
      read-timeout: ${NTS_BUSINESS_READ_TIMEOUT:5s}                                        # optional

# user.mutation.lock-timeout-ms: 2000          # optional — 회원 정보 변경 시 행 잠금 대기 상한

sapari:
  # 프로필 이미지 저장소. 로컬은 MinIO 등 S3 호환 저장소를 가리키면 된다.
  storage:
    object:
      s3:
        endpoint: ${S3_ENDPOINT:http://localhost:9000}            # REQUIRED
        region: ${S3_REGION:ap-northeast-2}                       # REQUIRED
        access-key: ${S3_ACCESS_KEY:}                             # REQUIRED
        secret-key: ${S3_SECRET_KEY:}                             # REQUIRED
        path-style-access-enabled: ${S3_PATH_STYLE_ACCESS:true}   # MinIO 는 true
        bucket: ${S3_BUCKET:sapari-local}                         # REQUIRED
        # 소문자 http(s) 절대 URL 만 받는다. 형식이 틀리면 기동이 거부된다.
        public-base-url: ${S3_PUBLIC_BASE_URL:http://localhost:9000/sapari-local}   # REQUIRED

  # 가입 인증 코드를 해시하는 키.
  signup-verification:
    security:
      hmac-secret: ${SIGNUP_VERIFICATION_HMAC_SECRET:}            # REQUIRED
    # email/phone 의 code-ttl(5m 고정)·verified-ttl(30m)·resend-cooldown(60s)·max-attempts(5) 는 optional.

  customer:
    social-signup:
      # 범위 밖이면 기동이 거부된다: max-attempts 1~20, window 1m~24h, lock-ttl 5s~10m 이고 lock-ttl < window.
      # lock-ttl 은 가입 처리 최악 시간보다 넉넉히, 수십 초 이상으로 둔다.
      attempt:
        max-attempts: ${SOCIAL_SIGNUP_MAX_ATTEMPTS:5}             # REQUIRED
        window: ${SOCIAL_SIGNUP_WINDOW:10m}                       # REQUIRED
        lock-ttl: ${SOCIAL_SIGNUP_LOCK_TTL:30s}                   # REQUIRED
    # 소셜 프로필 이미지 다운로드. timeout·크기는 미설정·0 이하면 기본값(2s·3s·5MiB),
    # 상한(5s·5MiB·redirect 3회)을 넘으면 기동이 거부된다.
    # max-redirects 는 미설정이면 0(redirect 안 따라감)이다 — 기본값 1 은 음수일 때만 적용된다.
    social-profile-image:
      download:
        max-redirects: ${SOCIAL_PROFILE_IMAGE_MAX_REDIRECTS:1}
        # connect-timeout: 2s
        # read-timeout: 3s
        # max-size-bytes: 5242880

  notification:
    email:
      from: ${EMAIL_FROM:}                                        # REQUIRED
      signup-verification-template-id: ${EMAIL_SIGNUP_TEMPLATE_ID:}   # REQUIRED
      resend:
        api-key: ${RESEND_API_KEY:}                               # REQUIRED
    sms:
      # 비어 있어도 기동은 된다 — 문자 발송만 실패한다.
      solapi:
        api-key: ${SOLAPI_API_KEY:}
        api-secret: ${SOLAPI_API_SECRET:}
        from: ${SOLAPI_FROM:}
